{
  "manifest_version": 3,
  "name": "HostOS Companion",
  "description": "Syncs your Turo fleet into HostOS, alerts you when something needs you, and drafts grounded replies.",
  "version": "3.1.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage",
    "sidePanel",
    "tabs",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://turo.com/*",
    "*://*.turo.com/*",
    "https://hostos-ten.vercel.app/*",
    "https://mail.google.com/*",
    "https://web.whatsapp.com/*",
    "https://app.slack.com/*",
    "https://*.slack.com/*",
    "https://teams.microsoft.com/*",
    "https://www.linkedin.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HostOS",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://turo.com/*",
        "*://*.turo.com/*"
      ],
      "js": [
        "fleetCalendar.js",
        "enrichment.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://turo.com/*",
        "*://*.turo.com/*",
        "https://mail.google.com/*",
        "https://web.whatsapp.com/*",
        "https://app.slack.com/*",
        "https://*.slack.com/*",
        "https://teams.microsoft.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": [
        "replyMatcher.js",
        "assist.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "generate_reply": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Draft a reply to the message on screen"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon128.png"
      ],
      "matches": [
        "*://*.turo.com/*",
        "https://mail.google.com/*",
        "https://web.whatsapp.com/*",
        "https://*.slack.com/*",
        "https://teams.microsoft.com/*",
        "https://www.linkedin.com/*"
      ]
    }
  ]
}
