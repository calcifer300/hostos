# HostOS — environment
# Copy to .env.local for local development; set the same names in Vercel for
# hostos-ten.vercel.app. Only the Supabase pair is genuinely required — every
# other variable switches a feature on. Startup prints what is missing and what
# each absence disables (src/lib/env.ts).

# ---------------------------------------------------------------- Supabase
# Required. Use the service_role / secret key (sb_secret_… or a legacy eyJ… JWT).
# RLS is on with no policies, so a publishable/anon key reads back as empty tables.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Per-request Supabase timeout in ms (default 6000, clamped to 1000-30000).
SUPABASE_TIMEOUT_MS=6000

# ---------------------------------------------------------------- Auth (Auth.js)
# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#   (production: https://hostos-ten.vercel.app/api/auth/callback/google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_URL=http://localhost:3000
# Gate every /app route on a session. Defaults: on in production, off in development.
# HOSTOS_REQUIRE_AUTH=true

# ---------------------------------------------------------------- Public URL
# The canonical address of this deployment: OG tags, the manifest, emails and
# the Companion's default HostOS URL all use it. Vercel's VERCEL_URL is the
# fallback, but that is a per-deploy hostname, so set the production alias.
NEXT_PUBLIC_APP_URL=https://hostos-ten.vercel.app

# ---------------------------------------------------------------- Secrets at rest
# Encrypts integration credentials (Shopify custom-app tokens, …) in
# integration_connections (migration 0022). 32+ random bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Falls back to AUTH_SECRET when unset; changing it invalidates stored tokens.
HOSTOS_ENCRYPTION_KEY=

# ---------------------------------------------------------------- AI Butler
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------- Email
# Resend. Alerts, invitations and the daily digest are computed regardless and
# sent only when a key is present. MAIL_FROM_EMAIL is the sender for
# transactional mail; DIGEST_FROM_EMAIL (legacy) is used for digests when set.
RESEND_API_KEY=
MAIL_FROM_EMAIL=HostOS <hello@your-domain.com>
DIGEST_FROM_EMAIL=

# ---------------------------------------------------------------- Cron
# Vercel Cron sends this as a bearer token to /api/cron/* (see vercel.json:
# digest daily, butler every 15 min, commerce hourly). Without it those routes
# refuse to run rather than expose URLs that email people on demand.
CRON_SECRET=

# ---------------------------------------------------------------- Gmail (optional)
# Opt-in and OFF by default — login never depends on it. Enable the Gmail API
# in Google Cloud and apply supabase/migrations/0001_gmail_sync.sql first.
GMAIL_SYNC_ENABLED=false
