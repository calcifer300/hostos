GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth (Auth.js) — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Auth.js
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_URL=http://localhost:3000

# Supabase (required only for Gmail sync)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail sync is opt-in and OFF by default — login never depends on it.
# Enable the Gmail API in Google Cloud and run
# supabase/migrations/0001_gmail_sync.sql first, then set to true.
GMAIL_SYNC_ENABLED=false
