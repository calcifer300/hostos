{
  "manifest_version": 3,
  "name": "HostOS Companion",
  "description": "Syncs your Turo fleet into HostOS — trips, guest messages, licence status and protection plans.",
  "version": "2.1.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://turo.com/*",
    "*://*.turo.com/*",
    "https://hostos-ten.vercel.app/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HostOS",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://turo.com/*",
        "*://*.turo.com/*"
      ],
      "js": [
        "fleetCalendar.js",
        "enrichment.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
