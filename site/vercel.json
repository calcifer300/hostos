{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "sveltekit",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hostoscollective.com"
        }
      ],
      "destination": "https://hostoscollective.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/outreach/",
      "destination": "https://hostos-outreach.vercel.app/outreach/"
    },
    {
      "source": "/outreach",
      "destination": "https://hostos-outreach.vercel.app/outreach"
    },
    {
      "source": "/outreach/:path*",
      "destination": "https://hostos-outreach.vercel.app/outreach/:path*"
    },
    {
      "source": "/app",
      "destination": "https://hostos-ten.vercel.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://hostos-ten.vercel.app/app/:path*"
    },
    {
      "source": "/cocruisers",
      "destination": "https://hostos-ten.vercel.app/cocruisers"
    },
    {
      "source": "/cocruisers/:path*",
      "destination": "https://hostos-ten.vercel.app/cocruisers/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://hostos-ten.vercel.app/brand/:path*"
    },
    {
      "source": "/pulse",
      "destination": "https://hostos-ten.vercel.app/pulse"
    },
    {
      "source": "/pulse/:path*",
      "destination": "https://hostos-ten.vercel.app/pulse/:path*"
    },
    {
      "source": "/login",
      "destination": "https://hostos-ten.vercel.app/login"
    },
    {
      "source": "/api/:path*",
      "destination": "https://hostos-ten.vercel.app/api/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://hostos-ten.vercel.app/_next/:path*"
    },
    {
      "source": "/team",
      "destination": "https://hostos-ten.vercel.app/team"
    },
    {
      "source": "/about",
      "destination": "https://hostos-ten.vercel.app/about"
    },
    {
      "source": "/install",
      "destination": "https://hostos-ten.vercel.app/install"
    },
    {
      "source": "/offline",
      "destination": "https://hostos-ten.vercel.app/offline"
    },
    {
      "source": "/sw.js",
      "destination": "https://hostos-ten.vercel.app/sw.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "https://hostos-ten.vercel.app/manifest.webmanifest"
    },
    {
      "source": "/icons/:path*",
      "destination": "https://hostos-ten.vercel.app/icons/:path*"
    },
    {
      "source": "/team/:path*",
      "destination": "https://hostos-ten.vercel.app/team/:path*"
    },
    {
      "source": "/opengraph-image",
      "destination": "https://hostos-ten.vercel.app/opengraph-image"
    },
    {
      "source": "/twitter-image",
      "destination": "https://hostos-ten.vercel.app/twitter-image"
    },
    {
      "source": "/hostos-companion.zip",
      "destination": "https://hostos-ten.vercel.app/hostos-companion.zip"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "https://hostos-ten.vercel.app/apple-touch-icon.png"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/team/:slug(ayie|belle|david|devie|gerald|jb|john|karl|karu|loisa|princess|red).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/faces/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.ico|icon.svg|icon-192.png|icon-512.png|apple-touch-icon.png|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
